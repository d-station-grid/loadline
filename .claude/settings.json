{
    "permissions": {
      "allow": ["Bash(make check)", "Bash(uv run pytest)", "Bash(npm run check)"]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gcloud-guard.py\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
