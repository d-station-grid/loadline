APP_ENV=development
DATABASE_URL=postgresql+asyncpg://loadline:loadline@localhost:5432/loadline
FIREBASE_PROJECT_ID=loadline-app
CORS_ORIGINS=["http://localhost:5173"]
# 空なら Gemini を呼ばずに定型の振り返りにする
GEMINI_PROJECT=
# 空なら Gemini が書いたセリフを確かめられないので、定型の振り返りにする
TYPESAFE_API_KEY=
# 振り返りを自動で作る内部の窓口。手元では空のまま（窓口は 401、dispatch は積まずにログだけ）
INTERNAL_AUDIENCE=
INTERNAL_CALLER_EMAIL=
TASKS_QUEUE=
