APP_ENV=development
DATABASE_URL=postgresql+asyncpg://loadline:loadline@localhost:5432/loadline
FIREBASE_PROJECT_ID=loadline-app
CORS_ORIGINS=["http://localhost:5173"]
# 空なら Gemini を呼ばずに定型の週次レビューにする
GEMINI_PROJECT=
# 空なら Gemini が書いたセリフを確かめられないので、定型の週次レビューにする
TYPESAFE_API_KEY=
# 週次レビューを自動で作る内部の窓口。手元では空のまま（窓口は 401、dispatch は積まずにログだけ）
INTERNAL_AUDIENCE=
INTERNAL_CALLER_EMAIL=
TASKS_QUEUE=
# 週次レビューのセリフを声にする tts の URL と、音声を置くバケット。どちらかが空なら声にせず、
# audio_url は null（文字だけ）。手元の利用者の資格情報では tts の ID トークンも署名付き URL も
# 作れないので、手元では空のまま
TTS_URL=
AUDIO_BUCKET=
