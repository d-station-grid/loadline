{
  "openapi": "3.1.0",
  "info": {
    "title": "loadline API",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "ID トークンで本人を確かめ、初回なら利用者の行を作って返す。",
        "operationId": "login_auth_login_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/ingest": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Receive",
        "description": "Health Auto Export の送信先。workouts と metrics を同じ URL で受け、中身で見分ける。",
        "operationId": "receive_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Read Settings",
        "operationId": "read_settings_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update Settings",
        "description": "設定をまとめて書き換える。検証は SettingsIn が済ませている。",
        "operationId": "update_settings_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/settings/ingest-token": {
      "post": {
        "tags": [
          "settings"
        ],
        "summary": "Reissue Ingest Token",
        "description": "取り込み用トークンを発行する。すでにあれば無効にして新しくする。平文はこの返事だけ。",
        "operationId": "reissue_ingest_token_settings_ingest_token_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestTokenOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HeartRatePoint": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "Min": {
            "type": "number",
            "title": "Min"
          },
          "Avg": {
            "type": "number",
            "title": "Avg"
          },
          "Max": {
            "type": "number",
            "title": "Max"
          }
        },
        "type": "object",
        "required": [
          "date",
          "Min",
          "Avg",
          "Max"
        ],
        "title": "HeartRatePoint",
        "description": "1 分ごとの心拍。キーが大文字なので alias で受ける。"
      },
      "IngestData": {
        "properties": {
          "workouts": {
            "items": {
              "$ref": "#/components/schemas/WorkoutIn"
            },
            "type": "array",
            "title": "Workouts"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricIn"
            },
            "type": "array",
            "title": "Metrics"
          }
        },
        "type": "object",
        "title": "IngestData"
      },
      "IngestPayload": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/IngestData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "IngestPayload"
      },
      "IngestResult": {
        "properties": {
          "workouts_added": {
            "type": "integer",
            "title": "Workouts Added",
            "default": 0
          },
          "workouts_updated": {
            "type": "integer",
            "title": "Workouts Updated",
            "default": 0
          },
          "workouts_skipped": {
            "type": "integer",
            "title": "Workouts Skipped",
            "default": 0
          },
          "vo2max_added": {
            "type": "integer",
            "title": "Vo2Max Added",
            "default": 0
          },
          "vo2max_skipped": {
            "type": "integer",
            "title": "Vo2Max Skipped",
            "default": 0
          }
        },
        "type": "object",
        "title": "IngestResult",
        "description": "受け口が返す集計。Health Auto Export の画面に出るだけなので、数だけ返す。"
      },
      "IngestTokenOut": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "last_four": {
            "type": "string",
            "title": "Last Four"
          }
        },
        "type": "object",
        "required": [
          "token",
          "last_four"
        ],
        "title": "IngestTokenOut",
        "description": "POST /settings/ingest-token の返事。平文のトークンはこのときだけ返す。"
      },
      "MetricIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/MetricPoint"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "MetricIn"
      },
      "MetricPoint": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "qty": {
            "type": "number",
            "title": "Qty"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "date",
          "qty"
        ],
        "title": "MetricPoint"
      },
      "Quantity": {
        "properties": {
          "qty": {
            "type": "number",
            "title": "Qty"
          }
        },
        "type": "object",
        "required": [
          "qty"
        ],
        "title": "Quantity"
      },
      "SettingsIn": {
        "properties": {
          "max_heart_rate": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 250.0,
                "minimum": 100.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Heart Rate"
          },
          "resting_heart_rate": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 30.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Resting Heart Rate"
          },
          "zone_boundary_1": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 250.0,
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone Boundary 1"
          },
          "zone_boundary_2": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 250.0,
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone Boundary 2"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Asia/Tokyo"
          },
          "review_weekday": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Review Weekday",
            "default": 0
          },
          "send_notes_to_ai": {
            "type": "boolean",
            "title": "Send Notes To Ai",
            "default": true
          }
        },
        "type": "object",
        "title": "SettingsIn",
        "description": "PUT /settings の本文。"
      },
      "SettingsOut": {
        "properties": {
          "max_heart_rate": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 250.0,
                "minimum": 100.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Heart Rate"
          },
          "resting_heart_rate": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 30.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Resting Heart Rate"
          },
          "zone_boundary_1": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 250.0,
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone Boundary 1"
          },
          "zone_boundary_2": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 250.0,
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone Boundary 2"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Asia/Tokyo"
          },
          "review_weekday": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Review Weekday",
            "default": 0
          },
          "send_notes_to_ai": {
            "type": "boolean",
            "title": "Send Notes To Ai",
            "default": true
          },
          "ingest_token_last_four": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingest Token Last Four"
          }
        },
        "type": "object",
        "title": "SettingsOut",
        "description": "GET /settings の返事。トークンは末尾 4 文字だけ。未発行なら None。"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "title": "UserOut",
        "description": "ログインした本人に返す情報。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkoutIn": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "duration": {
            "type": "number",
            "title": "Duration"
          },
          "source": {
            "$ref": "#/components/schemas/WorkoutSource"
          },
          "avgHeartRate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quantity"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxHeartRate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quantity"
              },
              {
                "type": "null"
              }
            ]
          },
          "heartRateData": {
            "items": {
              "$ref": "#/components/schemas/HeartRatePoint"
            },
            "type": "array",
            "title": "Heartratedata"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "start",
          "end",
          "duration",
          "source"
        ],
        "title": "WorkoutIn"
      },
      "WorkoutSource": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "WorkoutSource"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
