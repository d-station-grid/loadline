{
  "openapi": "3.1.0",
  "info": {
    "title": "loadline API",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "ID トークンで本人を確かめ、初回なら利用者の行を作って返す。",
        "operationId": "login_auth_login_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/dashboard": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Read Dashboard",
        "description": "本人の負荷と推移。since と until は利用者のタイムゾーンでの日付で、両端を含む。\n\nweeks は「直近 N 週」。since は until（省けば今日）の N 週前の日になる。since とは\n一緒に渡せない。期間の誤りは、入力の検査と同じ 422 の形（detail が loc と msg の配列）で返す。",
        "operationId": "read_dashboard_dashboard_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Until"
            }
          },
          {
            "name": "sport",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "run",
                "ride"
              ],
              "type": "string",
              "default": "all",
              "title": "Sport"
            }
          },
          {
            "name": "weeks",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 520,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Weeks"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Receive",
        "description": "Health Auto Export の送信先。workouts と metrics を同じ URL で受け、中身で見分ける。",
        "operationId": "receive_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/notes": {
      "get": {
        "tags": [
          "notes"
        ],
        "summary": "Read Notes",
        "description": "本人のメモを新しい日付から。since 以上、until 未満。",
        "operationId": "read_notes_notes_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Until"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "notes"
        ],
        "summary": "Add Note",
        "description": "メモを 1 件書く。走らなかった日にも書ける。1 日 1 件で、その日にもうあれば 409。",
        "operationId": "add_note_notes_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteOut"
                }
              }
            }
          },
          "400": {
            "description": "未来の日付"
          },
          "409": {
            "description": "その日のメモはもうある"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/notes/{note_id}": {
      "patch": {
        "tags": [
          "notes"
        ],
        "summary": "Edit Note",
        "description": "メモの本文やラベルを直す。送った項目だけを変え、日付は変えない。",
        "operationId": "edit_note_notes__note_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Note Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteOut"
                }
              }
            }
          },
          "404": {
            "description": "本人のメモにない"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "notes"
        ],
        "summary": "Remove Note",
        "description": "メモを消す。消した日には、また新しく書ける。",
        "operationId": "remove_note_notes__note_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "本人のメモにない"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Read Settings",
        "operationId": "read_settings_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update Settings",
        "description": "設定をまとめて書き換える。検証は SettingsIn が済ませている。",
        "operationId": "update_settings_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/settings/ingest-token": {
      "post": {
        "tags": [
          "settings"
        ],
        "summary": "Reissue Ingest Token",
        "description": "取り込み用トークンを発行する。すでにあれば無効にして新しくする。平文はこの返事だけ。",
        "operationId": "reissue_ingest_token_settings_ingest_token_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestTokenOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/workouts": {
      "get": {
        "tags": [
          "workouts"
        ],
        "summary": "Read Workouts",
        "description": "本人のワークアウトを新しい順に。since 以上、until 未満。\n\nweeks は「直近 N 週」。since は利用者のタイムゾーンの今日から N 週前の日の 0 時になる\n（ダッシュボードの weeks と同じ日）。since とは一緒に渡せない。\n\n続きを取るときは、前のページの最後の 1 件の started_at を until に、id を before_id に\n渡す。開始時刻が同じ記録がページの境目にあっても抜けない。before_id は until と一緒に使う。\nsince は 1 ページ目の応答の since を渡す。weeks を渡し直すと、日付をまたいだときに\n始まりが 1 日進み、境目の日の記録が続きから抜けるため。",
        "operationId": "read_workouts_workouts_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Until"
            }
          },
          {
            "name": "before_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "weeks",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 520,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Weeks"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workouts/{workout_id}": {
      "get": {
        "tags": [
          "workouts"
        ],
        "summary": "Read Workout",
        "description": "1 件の詳細。心拍の推移と、設定の境目がそろっていれば強度ごとの時間。",
        "operationId": "read_workout_workouts__workout_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "workout_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Workout Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Dashboard": {
        "properties": {
          "since": {
            "type": "string",
            "format": "date",
            "title": "Since"
          },
          "until": {
            "type": "string",
            "format": "date",
            "title": "Until"
          },
          "sport": {
            "type": "string",
            "enum": [
              "all",
              "run",
              "ride"
            ],
            "title": "Sport"
          },
          "needs_heart_rate_settings": {
            "type": "boolean",
            "title": "Needs Heart Rate Settings"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/DayPoint"
            },
            "type": "array",
            "title": "Days"
          },
          "vo2max": {
            "items": {
              "$ref": "#/components/schemas/Vo2maxPoint"
            },
            "type": "array",
            "title": "Vo2Max"
          },
          "zones": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ZoneSeconds"
              },
              {
                "type": "null"
              }
            ]
          },
          "workouts": {
            "items": {
              "$ref": "#/components/schemas/WorkoutPoint"
            },
            "type": "array",
            "title": "Workouts"
          }
        },
        "type": "object",
        "required": [
          "since",
          "until",
          "sport",
          "needs_heart_rate_settings",
          "days",
          "vo2max",
          "zones",
          "workouts"
        ],
        "title": "Dashboard",
        "description": "ダッシュボードの 1 画面ぶん。日付は利用者のタイムゾーンで区切る。\n\ndays は全種目で計算する（種目で絞ると疲労を低く見積もるため）。sport で絞るのは\nzones と workouts だけ。最大心拍か安静時心拍が未設定なら、負荷が出ないので days は空で、\nneeds_heart_rate_settings が true。"
      },
      "DayPoint": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "load": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Load"
          },
          "fitness": {
            "type": "number",
            "title": "Fitness"
          },
          "fatigue": {
            "type": "number",
            "title": "Fatigue"
          },
          "headroom": {
            "type": "number",
            "title": "Headroom"
          }
        },
        "type": "object",
        "required": [
          "day",
          "load",
          "fitness",
          "fatigue",
          "headroom"
        ],
        "title": "DayPoint",
        "description": "その日の終わりの体力・疲労・余力と、その日の負荷。\n\nload が None の日は、心拍の記録がないワークアウトを含む（負荷を 0 として計算を続けている）。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HeartRatePoint": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "Min": {
            "type": "number",
            "title": "Min"
          },
          "Avg": {
            "type": "number",
            "title": "Avg"
          },
          "Max": {
            "type": "number",
            "title": "Max"
          }
        },
        "type": "object",
        "required": [
          "date",
          "Min",
          "Avg",
          "Max"
        ],
        "title": "HeartRatePoint",
        "description": "1 分ごとの心拍。キーが大文字なので alias で受ける。"
      },
      "HeartRateSample": {
        "properties": {
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Recorded At"
          },
          "min_bpm": {
            "type": "integer",
            "title": "Min Bpm"
          },
          "avg_bpm": {
            "type": "integer",
            "title": "Avg Bpm"
          },
          "max_bpm": {
            "type": "integer",
            "title": "Max Bpm"
          }
        },
        "type": "object",
        "required": [
          "recorded_at",
          "min_bpm",
          "avg_bpm",
          "max_bpm"
        ],
        "title": "HeartRateSample",
        "description": "1 分ごとの心拍。"
      },
      "IngestData": {
        "properties": {
          "workouts": {
            "items": {
              "$ref": "#/components/schemas/WorkoutIn"
            },
            "type": "array",
            "title": "Workouts"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricIn"
            },
            "type": "array",
            "title": "Metrics"
          }
        },
        "type": "object",
        "title": "IngestData"
      },
      "IngestPayload": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/IngestData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "IngestPayload"
      },
      "IngestResult": {
        "properties": {
          "workouts_added": {
            "type": "integer",
            "title": "Workouts Added",
            "default": 0
          },
          "workouts_updated": {
            "type": "integer",
            "title": "Workouts Updated",
            "default": 0
          },
          "workouts_skipped": {
            "type": "integer",
            "title": "Workouts Skipped",
            "default": 0
          },
          "vo2max_added": {
            "type": "integer",
            "title": "Vo2Max Added",
            "default": 0
          },
          "vo2max_updated": {
            "type": "integer",
            "title": "Vo2Max Updated",
            "default": 0
          },
          "vo2max_skipped": {
            "type": "integer",
            "title": "Vo2Max Skipped",
            "default": 0
          }
        },
        "type": "object",
        "title": "IngestResult",
        "description": "受け口が返す集計。Health Auto Export の画面に出るだけなので、数だけ返す。"
      },
      "IngestTokenOut": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "last_four": {
            "type": "string",
            "title": "Last Four"
          }
        },
        "type": "object",
        "required": [
          "token",
          "last_four"
        ],
        "title": "IngestTokenOut",
        "description": "POST /settings/ingest-token の返事。平文のトークンはこのときだけ返す。"
      },
      "MetricIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/MetricPoint"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
